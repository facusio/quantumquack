<mxfile host="app.diagrams.net">
  <diagram id="arq-v1" name="Arquitectura v1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="&lt;b&gt;QuantumQuack Insurance — Arquitectura v1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Upload de fotos de siniestros: el contenedor nunca recibe la foto (Signed URL V4 → PUT directo a GCS)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- Navegador -->
        <mxCell id="browser" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;asegurado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- GitHub -->
        <mxCell id="gh" value="&lt;b&gt;GitHub — facusio/quantumquack&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#24292e;verticalAlign=top;align=left;spacingLeft=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="640" height="230" as="geometry" />
        </mxCell>
        <mxCell id="envdev" value="&lt;b&gt;Environment dev&lt;/b&gt;&lt;br&gt;required reviewers (aprobación manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="&lt;b&gt;ci.yml&lt;/b&gt; (PR)&lt;br&gt;fmt · validate · tflint · Checkov · Trivy · plan como comentario · Infracost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="170" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;deploy.yml&lt;/b&gt; (merge a main)&lt;br&gt;registry → build &amp;amp; push :commit → terraform apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="170" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="destroy" value="&lt;b&gt;destroy.yml&lt;/b&gt; (manual)&lt;br&gt;requiere input de confirmación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292e;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1460" y="170" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- GCP project -->
        <mxCell id="gcp" value="&lt;b&gt;GCP project — región us-central1 (free tier)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=10;arcSize=2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="1460" height="660" as="geometry" />
        </mxCell>

        <mxCell id="lb" value="&lt;b&gt;HTTP Load Balancer (serverless NEG)&lt;/b&gt;&lt;br&gt;puerto 80, sin certificado (no hay dominio)&lt;br&gt;OPCIONAL · ENABLE_LB=true · solo demo day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;dashed=1;dashPattern=8 4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="run" value="&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;Node 22 + Express (distroless)&lt;br&gt;min 0 / max 2 instancias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ar" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;imágenes :commit&lt;br&gt;conserva últimas 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="360" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mon" value="&lt;b&gt;Cloud Monitoring + Logging&lt;/b&gt;&lt;br&gt;dashboard + alertas&lt;br&gt;retención de logs 7 d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="360" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="saapp" value="&lt;b&gt;SA propia de la app&lt;/b&gt;&lt;br&gt;• storage.objectCreator solo en uploads/&lt;br&gt;• serviceAccountTokenCreator sobre sí misma&lt;br&gt;• sin Editor · sin key JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="500" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="iamcred" value="&lt;b&gt;IAM Credentials API&lt;/b&gt;&lt;br&gt;signBlob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="500" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="bucket" value="&lt;b&gt;Cloud Storage — bucket privado&lt;/b&gt;&lt;br&gt;prefijo uploads/&lt;br&gt;Public Access Prevention · uniform access" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="700" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="lifecycle" value="&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;• 30 d → Coldline&lt;br&gt;• 365 d → Archive&lt;br&gt;• TTL pruebas: delete a los 7 d&lt;br&gt;&lt;i&gt;TTL de 7 d solo para datos de prueba (uploads/test-* y uploads/sin-numero/)&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="700" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- Bootstrap -->
        <mxCell id="boot" value="&lt;b&gt;infra/bootstrap&lt;/b&gt; — apply manual una sola vez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;arcSize=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="500" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="wif" value="&lt;b&gt;Workload Identity Federation&lt;/b&gt;&lt;br&gt;pool + provider GitHub OIDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="550" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="saci" value="&lt;b&gt;SA de CI&lt;/b&gt;&lt;br&gt;roles por servicio (sin Editor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="550" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tfstate" value="&lt;b&gt;Bucket&lt;/b&gt;&lt;br&gt;Terraform state" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="550" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;Budget&lt;/b&gt;&lt;br&gt;alerta de costo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1560" y="550" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- Leyenda / límites de seguridad -->
        <mxCell id="legend" value="&lt;b&gt;Límites de seguridad&lt;/b&gt;&lt;br&gt;• La app usa SA propia; firma URLs con signBlob → no hay keys JSON&lt;br&gt;• IAM de la app restringido a escribir en uploads/ (no lee ni borra)&lt;br&gt;• Bucket privado: el navegador solo escribe con la URL firmada V4 (5 min, JPG, PNG o WEBP, ≤ 10 MB)&lt;br&gt;• CI/CD entra por WIF (OIDC de GitHub) → sin credenciales de larga vida&lt;br&gt;• Deploy requiere aprobación manual en el environment dev&lt;br&gt;&lt;br&gt;&lt;b&gt;Leyenda:&lt;/b&gt; línea gruesa = flujo de datos · punteada = opcional / identidad · amarillo = identidad e IAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1040" y="720" width="640" height="200" as="geometry" />
        </mxCell>

        <!-- ===== Edges: flujo principal ===== -->
        <mxCell id="e1" value="&lt;b&gt;1.&lt;/b&gt; POST /api/upload-url&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; ← Signed URL V4 (5 min, JPG, PNG o WEBP, ≤ 10 MB)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#1a73e8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="run">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_lb1" value="o vía LB (demo)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#4285F4;fontSize=10;exitX=0.75;exitY=1;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lb2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#4285F4;exitX=0.5;exitY=0;entryX=0;entryY=0.8125;" edge="1" parent="1" source="lb" target="run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="425" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_runsa" value="ejecuta como" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;dashPattern=2 3;strokeColor=#d6b656;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="saapp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="&lt;b&gt;2.&lt;/b&gt; signBlob" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;strokeWidth=2;strokeColor=#1a73e8;fontSize=10;exitX=1;exitY=0.35;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saapp" target="iamcred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="&lt;b&gt;4.&lt;/b&gt; PUT directo con la URL firmada → uploads/&lt;br&gt;(la foto nunca pasa por Cloud Run)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#188038;fontSize=10;exitX=0.3;exitY=1;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1" source="browser" target="bucket">
          <mxGeometry x="0.35" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_sabucket" value="objectCreator&lt;br&gt;solo uploads/*" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;dashPattern=2 3;strokeColor=#d6b656;fontSize=10;exitX=0.5;exitY=1;entryX=0.68;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saapp" target="bucket">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="650" />
              <mxPoint x="470" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_life" style="html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="lifecycle" target="bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ar" value="imagen" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4285F4;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ar" target="run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_mon" value="logs + métricas" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#4285F4;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="mon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="330" />
              <mxPoint x="1180" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Edges: CI/CD ===== -->
        <mxCell id="e_env" value="aprueba" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="envdev" target="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_oidc" value="token OIDC (sin keys)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#24292e;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy" target="wif">
          <mxGeometry x="-0.4" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1350" y="285" />
              <mxPoint x="1010" y="285" />
              <mxPoint x="1010" y="585" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_imp" value="impersona" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#24292e;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wif" target="saci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_push" value="push imagen :commit + terraform apply (infra/envs/dev)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#24292e;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saci" target="ar">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1315" y="470" />
              <mxPoint x="910" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_state" value="state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#24292e;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="saci" target="tfstate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
